{
  "name": "survey-builder-kit",
  "version": "0.1.0",
  "description": "Embeddable survey Builder and Runner React components -- JSON in, JSON out.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/survey-builder-kit.js",
  "module": "./dist/survey-builder-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/survey-builder-kit.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite build --watch --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "lint": "oxlint",
    "test": "vitest run --configLoader runner",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/material-renderers": "^3.8.0",
    "@jsonforms/react": "^3.8.0",
    "@mui/x-date-pickers": "^8.29.2",
    "@xyflow/react": "^12.11.6",
    "ajv": "^8.20.0",
    "dagre": "^0.8.5",
    "dayjs": "^1.10.7",
    "dexie": "^4.4.4",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.10"
  }
}
