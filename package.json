{
  "name": "survey-builder-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=survey-builder-app",
    "build": "npm run build --workspace=survey-builder-kit && npm run build --workspace=survey-builder-app",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
